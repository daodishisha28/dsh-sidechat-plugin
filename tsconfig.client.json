{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "types": ["react", "react-dom"],
    "typeRoots": ["./node_modules/@types"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "files": [
    "types/dsh-compat.d.ts",
    "src/client/index.ts",
    "src/client/api.ts",
    "src/client/components.tsx",
    "src/client/workflow-dialogs.tsx",
    "src/client/styles.ts",
    "src/client/locales.ts"
    ,"src/client/workflow-events.ts"
    ,"src/client/trajectory-panel.tsx"
    ,"src/types.ts",
    "src/seed.ts",
    "src/revision.ts"
  ]
}
