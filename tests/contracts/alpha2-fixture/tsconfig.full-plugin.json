{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "experimentalDecorators": false,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["../../../node_modules/@types"],
    "paths": {
      "@deepseek-ai/*": ["./node_modules/@deepseek-ai/*"],
      "@deepseek-ai/dsh-session/types": ["./node_modules/@deepseek-ai/dsh-session/lib/types/types"],
      "@deepseek-ai/dsh-api-session-controller/client": ["./node_modules/@deepseek-ai/dsh-api-session-controller/lib/types/client"],
      "@deepseek-ai/dsh-client-connection/client": ["./node_modules/@deepseek-ai/dsh-client-connection/lib/types/client"],
      "@deepseek-ai/dsh-client-locale/client": ["./node_modules/@deepseek-ai/dsh-client-locale/lib/types/client"],
      "@deepseek-ai/dsh-client-ui-chat/client": ["./node_modules/@deepseek-ai/dsh-client-ui-chat/lib/types/client"],
      "@deepseek-ai/dsh-client-ui-commands/client": ["./node_modules/@deepseek-ai/dsh-client-ui-commands/lib/types/client"],
      "@deepseek-ai/dsh-client-ui-conversation/client": ["./node_modules/@deepseek-ai/dsh-client-ui-conversation/lib/types/client"],
      "@deepseek-ai/dsh-client-ui-renderer/client": ["./node_modules/@deepseek-ai/dsh-client-ui-renderer/lib/types/client"],
      "@deepseek-ai/dsh-client-ui-session/client": ["./node_modules/@deepseek-ai/dsh-client-ui-session/lib/types/client"],
      "@deepseek-ai/dsh-client-ui-workspace/client": ["./node_modules/@deepseek-ai/dsh-client-ui-workspace/lib/types/client"],
      "@deepseek-ai/dsh-token-meter/client": ["./node_modules/@deepseek-ai/dsh-token-meter/lib/types/client"]
    }
  },
  "files": [
    "../../../src/index.ts",
    "../../../src/service.ts",
    "../../../src/trajectory.ts",
    "../../../src/usage.ts"
  ]
}
